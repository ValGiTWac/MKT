{
  "name": "whise-mkt-platform",
  "version": "1.0.0",
  "description": "WHISE Marketing Platform - Complete social media management solution",
  "private": true,
  "workspaces": [
    "frontend",
    "functions"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:functions\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:functions": "cd functions && npm run dev",
    "build": "npm run build:frontend && npm run build:functions",
    "build:frontend": "cd frontend && npm run build",
    "build:functions": "cd functions && npm run build",
    "lint": "npm run lint:frontend && npm run lint:functions",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:functions": "cd functions && npm run lint",
    "test": "npm run test:frontend && npm run test:functions",
    "test:frontend": "cd frontend && npm run test",
    "test:functions": "cd functions && npm run test",
    "clean": "rm -rf node_modules frontend/node_modules functions/node_modules dist",
    "prepare": "husky install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "whise",
    "marketing",
    "social-media",
    "netlify",
    "serverless",
    "collaboration"
  ],
  "author": "WHISE Marketing Team",
  "license": "MIT"
}
